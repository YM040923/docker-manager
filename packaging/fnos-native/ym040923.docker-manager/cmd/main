#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"

export PATH=/var/apps/nodejs_v22/target/bin:$PATH
export NODE_ENV=production
export FNOS_NATIVE=1
export FNOS_GATEWAY_PREFIX=/app/ym040923-docker-manager
export FNOS_SOCKET_PATH="${SOCKET_FILE}"
export SQLITE_PATH="${TRIM_PKGVAR}/docker-manager.db"
export STATIC_DIR="${TRIM_APPDEST}/ui"

CMD="node ${TRIM_APPDEST}/server/index.js"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    mkdir -p "${TRIM_PKGVAR}"
    rm -f "${SOCKET_FILE}"
    log_msg "Starting Docker Manager"
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping Docker Manager"
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            count=0
            while check_process "${pid}" && [ "${count}" -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    rm -f "${SOCKET_FILE}"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
