#!/bin/bash

# shellcheck source=common
source "$(dirname "${BASH_SOURCE[0]}")/common"
ensure_runtime_dirs

LOG_FILE="$DOCKER_MANAGER_LOG_FILE"
PID_FILE="$DOCKER_MANAGER_PID_FILE"
SOCKET_FILE="$DOCKER_MANAGER_SOCKET_FILE"

export PATH=/var/apps/nodejs_v22/target/bin:$PATH
export NODE_ENV=production
export FNOS_NATIVE=1
export FNOS_GATEWAY_PREFIX=/app/ym040923-docker-manager
export FNOS_SOCKET_PATH="${SOCKET_FILE}"
export SQLITE_PATH="${DOCKER_MANAGER_DB_FILE}"
export STATIC_DIR="${DOCKER_MANAGER_STATIC_DIR}"

CMD="node ${APP_DIR}/server/index.js"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    ensure_runtime_dirs
    rm -f "${SOCKET_FILE}"
    log_msg "Starting Docker Manager"
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping Docker Manager"
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            count=0
            while check_process "${pid}" && [ "${count}" -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    rm -f "${SOCKET_FILE}"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
