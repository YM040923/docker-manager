#!/usr/bin/env bash

resolve_path() {
  local input="$1"
  if [ -d "$input" ]; then
    cd "$input" && pwd
    return
  fi
  case "$input" in
    /*)
      printf '%s\n' "$input"
      ;;
    *)
      printf '%s/%s\n' "$(pwd)" "$input"
      ;;
  esac
}

resolve_package_base() {
  if [ -n "${TRIM_APPDEST:-}" ]; then
    resolve_path "$TRIM_APPDEST"
    return
  fi
  if [ -n "${SYNOPKG_PKGDEST:-}" ]; then
    resolve_path "$SYNOPKG_PKGDEST"
    return
  fi
  cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd
}

PACKAGE_BASE="$(resolve_package_base)"
APP_DIR="$(resolve_path "${DOCKER_MANAGER_APP_DIR:-${TRIM_APPDEST:-$PACKAGE_BASE/app}}")"
VAR_DIR="$(resolve_path "${DOCKER_MANAGER_VAR_DIR:-${TRIM_PKGVAR:-$PACKAGE_BASE/var}}")"
RUN_DIR="$VAR_DIR/run"
LOG_DIR="$VAR_DIR/log"
DATA_DIR="$VAR_DIR/data"

export DOCKER_MANAGER_LOG_FILE="${DOCKER_MANAGER_LOG_FILE:-$LOG_DIR/info.log}"
export DOCKER_MANAGER_PID_FILE="${DOCKER_MANAGER_PID_FILE:-$RUN_DIR/app.pid}"
export DOCKER_MANAGER_SOCKET_FILE="${DOCKER_MANAGER_SOCKET_FILE:-$APP_DIR/app.sock}"
export DOCKER_MANAGER_DB_FILE="${DOCKER_MANAGER_DB_FILE:-$DATA_DIR/docker-manager.db}"
export DOCKER_MANAGER_STATIC_DIR="${DOCKER_MANAGER_STATIC_DIR:-$APP_DIR/ui}"

ensure_runtime_dirs() {
  mkdir -p "$RUN_DIR" "$LOG_DIR" "$DATA_DIR"
}
